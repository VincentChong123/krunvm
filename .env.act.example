# ==============================================================================
# krunvm act CI Runner MicroVM Profile (.env.act.example)
# Provides dedicated hardware-isolated runner environment matching GitHub Actions VM
# ==============================================================================

# Target microVM instance name
VM_NAME="krun-act-runner"

# OCI base image tag & Containerfile path
OCI_BASE_IMAGE="localhost/krun-act-runner:latest"
CONTAINERFILE="configs/Containerfile.act-runner"

# Hardware allocation (Sized for ThinkPad 16GB RAM: 4 vCPUs / 6GB RAM)
VM_CPUS="4"
VM_MEMORY="6144"

# Guest user inside microVM (matches Ubuntu 24.04 default non-root user)
VM_USER="ubuntu"
VM_VENV_DIR="/var/venv"

# Host volume mounts: Target repository mounted directly into /workspace
# Syntax: <host_path>:<guest_path>[:rw|:ro]
VOLUMES="
${HOME}/ws/github/VincentChong123/local-infra:/workspace:rw
"

# Host Telemetry & Observability Ports
HOST_LANGFUSE_PORT="3100"
HOST_OTEL_EXPORTER_PORT="4318"
HOST_TARGET_IP="127.0.0.1"
