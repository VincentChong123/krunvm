# ==============================================================================
# .env.mapped_dir.example - krunvm Sandbox Directory Mounts
# ==============================================================================
# Define host directories to map into the krunvm microVM sandbox.
#
# Syntax (docker-compose style):
#   <host_pc_dir>:<vm_dir>[:ro|:rw]
#
# Examples:
#   ~/ws/github/VincentChong123/krunvm:/workspace:rw
#   # ~/datasets:/datasets:ro
#   # ${PWD}/scratch:/scratch:rw
#
# Requirements & Constraints:
#   1. <vm_dir> must be a single direct root child (e.g. /workspace, /scratch, /data).
#      Nested guest paths like /mnt/workspace are not supported by krunvm.
#   2. The first mapped directory will be used as the default working directory (--workdir).
#   3. For security, mounting '/', '/home', or the user's root home directory is blocked.
# ==============================================================================

/home/vin/ws/github/VincentChong123/krunvm:/workspace:rw
