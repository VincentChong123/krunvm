# ==============================================================================
# krunvm MicroVM Configuration Template (.env.example)
# Copy this file to .env or .env.host and adjust variables for your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Persistent Sandbox Configuration
# ------------------------------------------------------------------------------
# Target persistent microVM instance name in krunvm
VM_NAME="krun-agent-persistent"

# Base OCI image tag built via configs/Containerfile and Buildah
OCI_BASE_IMAGE="localhost/krun-agent-sandbox:latest"

# Virtual CPU cores allocated to the persistent microVM
VM_CPUS="4"

# Memory allocation in Megabytes (MB)
VM_MEMORY="4096"

# Guest user account inside the microVM (UID 1000)
VM_USER="ubuntu"

# Native microVM directory for isolated Python virtual environments
VM_VENV_DIR="/var/venv"

# ------------------------------------------------------------------------------
# 2. Ephemeral Subagent MicroVM Configuration
# ------------------------------------------------------------------------------
# Sizing for sub-100ms disposable YOLO-mode subagents launched on-demand
EPHEMERAL_CPUS="2"
EPHEMERAL_MEMORY="2048"

# ------------------------------------------------------------------------------
# 3. Host Volume Mounts (Docker convention: <host_path>:<vm_path>[:rw|:ro])
# Note: krunvm requires guest paths to be direct root children (e.g. /workspace, /config)
# ------------------------------------------------------------------------------
VOLUMES="
${PWD}:/workspace:rw
"

# ------------------------------------------------------------------------------
# 4. Host Telemetry & Observability Bridge
# ------------------------------------------------------------------------------
# Langfuse server port on host machine
HOST_LANGFUSE_PORT="3100"

# OpenTelemetry OTLP endpoint port on host machine (HTTP)
HOST_OTEL_EXPORTER_PORT="4318"

# Host loopback or bridge IP reachable via Transparent Socket Impersonation (TSI)
HOST_TARGET_IP="127.0.0.1"
