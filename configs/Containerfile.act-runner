# syntax=docker/dockerfile:1
# ==============================================================================
# Containerfile.act-runner - Dedicated OCI Image for krunvm act CI Runner
# Provides a full VM runner environment matching github.com ubuntu-latest specs.
# ==============================================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Install core build utilities, Docker Engine CLI + Compose v2, Node.js runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    build-essential \
    jq \
    iproute2 \
    sudo \
    vim \
    nano \
    openssl \
    tar \
    gzip \
    fuse-overlayfs \
    docker.io \
    docker-compose-v2 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Configure Docker daemon for minimal microVM kernel (disable iptables and use fuse-overlayfs for CoW on virtiofs)
RUN mkdir -p /etc/docker && \
    echo '{\n  "iptables": false,\n  "ip6tables": false,\n  "storage-driver": "fuse-overlayfs"\n}' > /etc/docker/daemon.json

# Pre-configure act defaults to self-hosted mode for instant startup without container pull
RUN echo "-P ubuntu-latest=-self-hosted" > /root/.actrc && \
    mkdir -p /home/ubuntu && \
    echo "-P ubuntu-latest=-self-hosted" > /home/ubuntu/.actrc

# Install helper script to automatically ensure dockerd is running with fuse-overlayfs driver
RUN printf '#!/usr/bin/env bash\n\
if ! pgrep -x dockerd >/dev/null 2>&1; then\n\
    mkdir -p /etc/docker\n\
    if [ ! -f /etc/docker/daemon.json ] || ! grep -q '\''"storage-driver": "fuse-overlayfs"'\'' /etc/docker/daemon.json 2>/dev/null; then\n\
        echo '\''{"iptables":false,"ip6tables":false,"storage-driver":"fuse-overlayfs"}'\'' > /etc/docker/daemon.json\n\
    fi\n\
    dockerd >/var/log/dockerd.log 2>&1 &\n\
    for _ in $(seq 1 30); do\n\
        if docker ps >/dev/null 2>&1; then break; fi\n\
        sleep 0.5\n\
    done\n\
fi\n' > /usr/local/bin/ensure-dockerd.sh && \
    chmod +x /usr/local/bin/ensure-dockerd.sh && \
    echo 'sudo /usr/local/bin/ensure-dockerd.sh >/dev/null 2>&1 || true' >> /etc/bash.bashrc && \
    printf 'export TERM="${TERM:-xterm-256color}"\nset -o history\nshopt -s histappend checkwinsize\nexport HISTSIZE=5000\nexport HISTFILESIZE=10000\nexport HISTFILE="$HOME/.bash_history"\n' >> /etc/bash.bashrc

# Install nektos/act binary at /usr/local/bin/act
RUN mkdir -p /tmp && chmod 1777 /tmp && \
    curl -s https://raw.githubusercontent.com/nektos/act/master/install.sh | bash -s -- -b /usr/local/bin

# Pre-install commitlint globally for fast offline commit linting
RUN npm install -g @commitlint/cli @commitlint/config-conventional

# Configure non-root ubuntu user (UID 1000) with passwordless sudo & docker group
RUN if ! id -u ubuntu >/dev/null 2>&1; then \
        groupadd -g 1000 ubuntu && useradd -u 1000 -g 1000 -m -s /bin/bash ubuntu; \
    fi && \
    groupadd -f docker && \
    usermod -aG docker ubuntu && \
    echo "ubuntu ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/ubuntu && \
    chmod 0440 /etc/sudoers.d/ubuntu

# Pre-create standard workspace mount point
RUN mkdir -p /workspace && chown ubuntu:ubuntu /workspace

USER ubuntu
WORKDIR /workspace

CMD ["/bin/bash"]
