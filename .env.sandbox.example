# ==============================================================================
# krunvm Guest Sandbox Environment Template (.env.sandbox.example)
# Deployed to ~/.gemini/antigravity-cli/.env inside the microVM (chmod 600)
# ==============================================================================

# Langfuse Project API Keys (Obtain from your local Langfuse server)
IS_LANGFUSE_ENABLED="true"
LANGFUSE_PUBLIC_KEY="pk-lf-local-sandbox-dev-key"
LANGFUSE_SECRET_KEY="sk-lf-local-sandbox-dev-key"
LANGFUSE_PUBLIC_KEY_AGY="pk-lf-local-sandbox-agy-key"
LANGFUSE_SECRET_KEY_AGY="sk-lf-local-sandbox-agy-key"

# Host endpoints (Resolved dynamically via TSI)
LANGFUSE_CONNECT_IP="127.0.0.1"
LANGFUSE_UI_PORT="3100"
LANGFUSE_SERVER_URL="http://127.0.0.1:3100"
LANGFUSE_HOST="http://127.0.0.1:3100"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"

# Autonomous Agent Scoped Tokens
# GITHUB_TOKEN=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""
