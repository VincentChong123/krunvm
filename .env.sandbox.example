# ==============================================================================
# krunvm Guest Sandbox Configuration Template (.env.sandbox.example)
# Destination inside guest VM: ~/.gemini/antigravity-cli/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# Observability & Antigravity Telemetry
# ------------------------------------------------------------------------------
IS_LANGFUSE_ENABLED="true"
LANGFUSE_LISTEN_IP="0.0.0.0"
LANGFUSE_CONNECT_IP="127.0.0.1"
LANGFUSE_UI_PORT="3100"
LANGFUSE_SERVER_URL="http://${LANGFUSE_CONNECT_IP}:${LANGFUSE_UI_PORT}"
LANGFUSE_PUBLIC_KEY="pk-lf-local-dev"
LANGFUSE_SECRET_KEY="sk-lf-local-dev"
LANGFUSE_PUBLIC_KEY_AGY="pk-lf-local-dev"
LANGFUSE_SECRET_KEY_AGY="sk-lf-local-dev"

LANGFUSE_HOST="http://127.0.0.1:3100"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:3100/api/public/otel"
